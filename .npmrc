# @bcbp-solutions-fzc-llc/* packages come from GitHub Packages and need a token with read:packages
# in NODE_AUTH_TOKEN (developers: `export NODE_AUTH_TOKEN=$(gh auth token)` after
# `gh auth refresh -s read:packages`; CI: secrets.GITHUB_TOKEN with packages: read).
@bcbp-solutions-fzc-llc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
