{
  "name": "app1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "docker:dev": "docker run -it --rm -p 5173:5173 -v %cd%:/app -v /app/node_modules node:26-alpine sh -c \"cd /app && npm install && npm run dev\"",
    "docker:dev:mac": "docker run -it --rm -p 5173:5173 -v $(pwd):/app -v /app/node_modules node:26-alpine sh -c \"cd /app && npm install && npm run dev\"",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage && node .github/scripts/coverage-gate.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "preview": "vite preview --port 5001 --strictPort",
    "keycloak:dev": "node scripts/keycloak-compose.mjs up",
    "keycloak:dev:detach": "node scripts/keycloak-compose.mjs up -d",
    "keycloak:logs": "node scripts/keycloak-compose.mjs logs -f keycloak",
    "keycloak:status": "node scripts/check-keycloak.mjs",
    "keycloak:setup": "node scripts/setup-keycloak.mjs",
    "keycloak:seed-user": "node scripts/seed-keycloak-user.mjs"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.8",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "daisyui": "^5.7.50",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "keycloak-js": "^26.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  }
}
