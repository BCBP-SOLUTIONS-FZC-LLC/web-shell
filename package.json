{
  "name": "app1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "docker:dev": "docker run -it --rm -p 5001:5001 -e NODE_AUTH_TOKEN -v %cd%:/app -v /app/node_modules node:26-alpine sh -c \"cd /app && npm ci && npm run dev\"",
    "docker:dev:mac": "docker run -it --rm -p 5001:5001 -e NODE_AUTH_TOKEN -v $(pwd):/app -v /app/node_modules node:26-alpine sh -c \"cd /app && npm ci && npm run dev\"",
    "build": "tsc && rsbuild build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage && node .github/scripts/coverage-gate.mjs",
    "test-unit": "vitest run test/unit",
    "test-int": "vitest run test/integration",
    "test-e2e": "vitest run test/e2e",
    "test-smoke": "vitest run --config vitest.smoke.config.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "preview": "rsbuild preview",
    "keycloak:dev": "node scripts/keycloak-compose.mjs up",
    "keycloak:dev:detach": "node scripts/keycloak-compose.mjs up -d",
    "keycloak:logs": "node scripts/keycloak-compose.mjs logs -f keycloak",
    "keycloak:status": "node scripts/check-keycloak.mjs",
    "keycloak:setup": "node scripts/setup-keycloak.mjs",
    "keycloak:seed-user": "node scripts/seed-keycloak-user.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@bcbp-solutions-fzc-llc/eslint-plugin": "1.0.0-alpha.4",
    "@bcbp-solutions-fzc-llc/webpack-preset": "1.0.0-alpha.4",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@bcbp-solutions-fzc-llc/frontend-sdk": "1.0.0-alpha.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@opentelemetry/api": "1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  }
}
