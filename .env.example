# Real Keycloak (Docker): npm run keycloak:setup — then http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bcbp
VITE_KEYCLOAK_CLIENT_ID=app1

# Optional exact redirect (default: http://localhost:5001/dashboard)
# VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5001/dashboard
# Client "app1" redirect URIs: http://localhost:5001/*

# Dashboard remote (mfe-dashboard)
VITE_APP2_URL=http://localhost:5002
